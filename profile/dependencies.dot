// How the organization's packages depend on each other: the source of
// dependencies.svg beside it, which profile/README.md shows.
//
// A node is the `[project]` name of every tree of the organization that
// builds a distribution, `[build-system]` being what says it does. A tree
// that builds none is not drawn, and neither is an arrow into or out of
// one. A grey dashed outline is not a package of the organization but a C
// library one of them bundles: the submodule `X` of such a tree is the
// node `libX`.
//
// An arrow points from a project up to what it depends on: solid where
// `dependencies` in its pyproject.toml names the target, and dashed where
// only an `optional-dependencies` extra does. An arrow is drawn only
// where the dependent, bare or with one of its extras, does not already
// install its target, with the extras it asks of it, through the arrows
// that are drawn: `btclib-wallet[secp256k1]` asks `btclib[secp256k1]`,
// which asks `ecc[secp256k1]`, so `btclib-wallet`'s own requirement of
// `btclib-secp256k1` draws nothing, while `btclib-node` asks
// `btclib[secp256k1]` and `bip32-descriptors`' `dependencies` ask bare
// `btclib`, so `btclib-node`'s arrow to `btclib` is drawn beside its
// arrow to `bip32-descriptors`. The extras are written nowhere, and
// dependency groups are left out, being what a checkout of the tree
// installs rather than what a user of the package does. A requirement on
// a name no tree builds, a retired one included, draws nothing. A dotted
// line with no arrowhead, labelled `bundled`, joins a package to a C
// library that is a submodule of its tree, built into the package rather
// than installed beside it.
// tests/dependencies_test.py compares this file with every tree's
// pyproject.toml and .gitmodules, and names every requirement on a
// retired name.
//
// Every position is set by hand and rendered as it stands, by neato with
// `nop: 2` in .github/scripts/render_dependencies.mjs, which takes the
// nodes and the edges where they are written. A node's `pos` is its
// centre in points, y growing upward, and a row is a level: what a
// package depends on sits above it, in four columns 145 apart. An edge's
// `pos` is its route as the control points of a spline whose segments
// are straight, `e,` giving where the arrowhead's tip lands, and a
// label's `lp` is where it is written. `bip32-descriptors` sits under
// `btclib` and `btclib-benchmarks` under it, so that the arrows of
// `btclib-functional-tests` and `btclib-node` into `btclib` pass on
// either side of `bip32-descriptors`. Every other arrow of
// `btclib-benchmarks` leaves its box from below and runs round the
// outside.
//
// The colours are for a transparent background under both of GitHub's
// themes: text sits on the fill of its box, and the grey of the arrows
// and of the outlined C libraries reads on the light theme's white and
// the dark theme's near-black.
digraph dependencies {
    graph [bgcolor="transparent", outputorder=edgesfirst, pad=0.2];
    node [shape=box, style="rounded,filled", color="#1f6feb", fillcolor="#1f6feb",
          fontcolor="#ffffff", fontname="Helvetica", fontsize=12, width=1.7, height=0.5, fixedsize=true];
    edge [color="#7d8590", fontcolor="#7d8590", fontname="Helvetica", fontsize=10, arrowsize=0.7];

    "libsecp256k1"     [pos="290,560", style="rounded,dashed", color="#7d8590", fontcolor="#7d8590"];
    "libsecp256k1-zkp" [pos="435,560", style="rounded,dashed", color="#7d8590", fontcolor="#7d8590"];
    "base58-bech32"    [pos="145,560"];
    "bip39-slip39"     [pos="0,560"];
    "bitcoin-core-rpc" [pos="145,460"];
    "btclib-secp256k1" [pos="290,460"];
    "ecc"              [pos="290,360"];
    "btclib"           [pos="290,260"];
    "btclib-wallet"           [pos="0,160"];
    "bip32-descriptors"       [pos="290,160"];
    "btclib-functional-tests" [pos="145,60"];
    "btclib-benchmarks"       [pos="290,60"];
    "btclib-node"             [pos="435,60"];

    "btclib-secp256k1" -> "libsecp256k1" [style=dotted, arrowhead=none, label="bundled", lp="262,510",
        pos="290,478 290,478 290,542 290,542"];
    "btclib-secp256k1" -> "libsecp256k1-zkp" [style=dotted, arrowhead=none, label="bundled", lp="463,526",
        pos="320,478 320,478 320,510 320,510 320,510 435,510 435,510 435,510 435,542 435,542"];
    "ecc" -> "btclib-secp256k1" [style=dashed,
        pos="e,290,442 290,378 290,378 290,435 290,435"];
    "btclib" -> "ecc" [pos="e,290,342 290,278 290,278 290,335 290,335"];
    "btclib-wallet" -> "btclib"
        [pos="e,229,270 20,178 20,178 20,270 20,270 20,270 222,270 222,270"];
    "bip32-descriptors" -> "btclib" [
        pos="e,290,242 290,178 290,178 290,235 290,235"];
    "btclib-functional-tests" -> "bip32-descriptors"
        [pos="e,250,142 185,78 185,78 185,110 185,110 185,110 250,110 250,110 250,110 250,135 250,135"];
    "btclib-functional-tests" -> "btclib"
        [pos="e,229,250 165,78 165,78 165,250 165,250 165,250 222,250 222,250"];
    "btclib-functional-tests" -> "bitcoin-core-rpc" [
        pos="e,125,442 125,78 125,78 125,435 125,435"];
    "btclib-benchmarks" -> "bip32-descriptors" [
        pos="e,290,142 290,78 290,78 290,135 290,135"];
    "btclib-node" -> "bip32-descriptors"
        [pos="e,330,142 395,78 395,78 395,110 395,110 395,110 330,110 330,110 330,110 330,135 330,135"];
    "btclib-node" -> "btclib"
        [pos="e,351,250 435,78 435,78 435,250 435,250 435,250 358,250 358,250"];
    "btclib-node" -> "bitcoin-core-rpc"
        [pos="e,185,442 465,78 465,78 465,310 465,310 465,310 185,310 185,310 185,310 185,435 185,435"];
    "btclib-benchmarks" -> "btclib-secp256k1"
        [pos="e,351,460 330,42 330,42 330,25 330,25 330,25 530,25 530,25 530,25 530,460 530,460 530,460 358,460 358,460"];
    "btclib-benchmarks" -> "base58-bech32"
        [pos="e,145,578 310,42 310,42 310,15 310,15 310,15 545,15 545,15 545,15 545,600 545,600 545,600 145,600 145,600 145,600 145,585 145,585"];
    "btclib-benchmarks" -> "bip39-slip39"
        [pos="e,0,578 250,42 250,42 250,20 250,20 250,20 -80,20 -80,20 -80,20 -80,610 -80,610 -80,610 0,610 0,610 0,610 0,585 0,585"];
    "btclib-wallet" -> "bitcoin-core-rpc"
        [pos="e,84,460 -20,178 -20,178 -20,460 -20,460 -20,460 77,460 77,460"];
    "btclib-wallet" -> "bip39-slip39"
        [pos="e,-40,542 -40,178 -40,178 -40,535 -40,535"];
}
